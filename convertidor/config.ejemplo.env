# Copiá este archivo con el nombre "config.env" (en esta misma carpeta) y
# sacá el "#" de las líneas que quieras usar. "config.env" no se pisa al
# actualizar la app.

# Puerto donde corre la app (por defecto 8000).
# PUERTO=8000

# Minutos máximos por archivo antes de cancelarlo como error (por defecto 10).
# TIEMPO_MAX_MIN=10

# Copia cada resultado .md a esta carpeta cuando termina. Si es una carpeta de
# Google Drive (Drive para escritorio), los .md aparecen solos en el celular.
# COPIAR_A=G:\Mi unidad\Convertidos

# Clave para entrar a la app (se pide al abrir la página; usuario: cualquiera).
# CLAVE=mi-clave

# Dónde se guardan los archivos subidos y los resultados.
# DATOS_DIR=C:\Convertidor\datos

# Tamaño máximo por subida, en MB (por defecto 500).
# MAX_MB=500
